# Firebase Configuration for Shashtak Platform
# Obtain these values from: Firebase Console > Project Settings > General > Your apps > Web app (SDK setup and configuration)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=shashtak-tv.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shashtak-tv
VITE_FIREBASE_STORAGE_BUCKET=shashtak-tv.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

